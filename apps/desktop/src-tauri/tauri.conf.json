{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "IPMsgSec",
  "version": "0.1.0",
  "identifier": "org.ipmsgsec.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "IPMsgSec",
        "width": 900,
        "height": 620,
        "minWidth": 640,
        "minHeight": 420,
        "center": true,
        "visible": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"]
  }
}
